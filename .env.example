# ==============================================================================
# StockPilot Environment Configuration Template
# Copy this file to .env and replace placeholder values with secure credentials.
# NEVER commit .env to source control!
# ==============================================================================

# Node.js Application Environment
NODE_ENV=development
PORT=3000
SESSION_SECRET=replace_with_secure_random_session_secret_at_least_32_chars

# Microsoft SQL Server (Primary Business Database)
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=StockPilotDB
DB_USER=stockpilot_app
DB_PASSWORD=YourStrong@Passw0rd
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# Database SA credentials (Used for initial migrations/container setup only)
MSSQL_SA_PASSWORD=YourStrong@Passw0rd123!
ACCEPT_EULA=Y

# Read-Only Database User for Metabase Business Intelligence
DB_BI_USER=stockpilot_bi_readonly
DB_BI_PASSWORD=YourStrong@Passw0rdBI!

# FastAPI Machine Learning Service
ML_SERVICE_HOST=localhost
ML_SERVICE_PORT=8000
ML_SERVICE_URL=http://localhost:8000
ML_INTERNAL_API_KEY=replace_with_internal_service_token

# Metabase BI Dashboard
METABASE_PORT=3001
METABASE_SITE_URL=http://localhost:3001
# Embedded H2 used for local development metadata; PostgreSQL optional for production metadata
METABASE_DB_TYPE=h2
